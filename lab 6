#include <Arduino.h>
#include <ESP8266WiFi.h>
#include <FirebaseESP8266.h>

#define WIFI_SSID "HONOR X8B"
#define WIFI_PASSWORD "22222222"

#define FIREBASE_HOST "https://iot-project-1-953c1-default-rtdb.firebaseio.com/"
#define FIREBASE_AUTH "t-rtdbJAhEzEyHJu9cJ9fZmQb87VIMSHVZIeKYOOi5SiSB"

#define LED_PIN 4
#define PIR_PIN 12
#define LDR_PIN A0

FirebaseData fbdo;
FirebaseConfig config;
FirebaseAuth auth;

void setup() {

  Serial.begin(115200);

  pinMode(LED_PIN, OUTPUT);
  pinMode(PIR_PIN, INPUT);

  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
  Serial.print("Connecting to WiFi");

  while (WiFi.status() != WL_CONNECTED) {
    delay(300);
    Serial.print(".");
  }

  Serial.println();
  Serial.print("Connected. IP: ");
  Serial.println(WiFi.localIP());

  config.host = FIREBASE_HOST;
  config.signer.tokens.legacy_token = FIREBASE_AUTH;

  Firebase.begin(&config, &auth);
  Firebase.reconnectWiFi(true);
}

void loop() {

  // LED Control
  if (Firebase.getString(fbdo, "/control/led")) {

    String state = fbdo.stringData();

    if (state == "ON")
      digitalWrite(LED_PIN, HIGH);
    else if (state == "OFF")
      digitalWrite(LED_PIN, LOW);

    Serial.print("LED: ");
    Serial.println(state);
  }

  // Read Sensors
  int pirState = digitalRead(PIR_PIN);
  int ldrValue = analogRead(LDR_PIN);

  Serial.print("PIR: ");
  Serial.print(pirState);

  Serial.print(" | LDR: ");
  Serial.println(ldrValue);

  // Upload Sensor Data
  Firebase.setInt(fbdo, "/sensor/pir", pirState);
  Firebase.setInt(fbdo, "/sensor/ldr", ldrValue);

  delay(500);
}
